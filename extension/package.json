{
  "name": "arena-screenshotter",
  "displayName": "Arena screenshotter",
  "version": "0.0.0",
  "description": "Save screenshots of sites to are.na",
  "author": "Tyler McRobert",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aredotna/sdk": "^0.0.4",
    "@plasmohq/messaging": "^0.6.2",
    "gifenc": "^1.0.3",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "4.1.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "8.4.33",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.33.0",
      "jiti": "2.4.2"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "@swc/core",
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ],
    "patchedDependencies": {
      "jiti": "patches/jiti.patch",
      "@tailwindcss/oxide": "patches/@tailwindcss__oxide.patch"
    }
  },
  "manifest": {
    "key": "",
    "name": "Are.na screenshotter",
    "version": "0.4.0",
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "activeTab",
      "contextMenus",
      "identity",
      "storage",
      "tabCapture",
      "offscreen",
      "unlimitedStorage"
    ],
    "oauth2": {
      "client_id": "w00O0_Pl7ZIA9wjnG6CBarNnivmCcGqxTSTE9__TZ4Y",
      "scopes": []
    },
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/iframe.html"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Alt+S",
          "mac": "MacCtrl+S"
        },
        "description": "Toggle Are.na screenshotter"
      },
      "toggle-recording": {
        "suggested_key": {
          "default": "Alt+R",
          "mac": "MacCtrl+R"
        },
        "description": "Start or stop recording the current tab"
      }
    }
  }
}
