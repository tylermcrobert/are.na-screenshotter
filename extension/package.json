{
  "name": "arena-screenshotter",
  "displayName": "Arena screenshotter",
  "version": "0.1.0",
  "description": "Save screenshots of sites to are.na",
  "author": "Tyler McRobert",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "plasmo": "0.86.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.33.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "@swc/core",
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "manifest": {
    "name": "Are.na screenshotter",
    "version": "0.1.0",
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "activeTab",
      "identity",
      "storage"
    ],
    "oauth2": {
      "client_id": "$PLASMO_PUBLIC_ARENA_OAUTH_CLIENT_ID",
      "scopes": []
    },
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/iframe.html"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}
