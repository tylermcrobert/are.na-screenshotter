{
  "manifest_version": 2,
  "name": "Viewport — Visual Bookmarks",
  "description": "Viewport is a visual website organizer",
  "version": "1.0.0",
  "icons": {
    "128": "icon_128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icon.png"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
